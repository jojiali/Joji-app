{
  "id": "com.jojiali.quranbot",
  "name": "Quran Arabic Bot",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.1.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:8765", "http://localhost:8765"]
    },
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "id": "quranbot",
      "type": "panel",
      "label": { "default": "Quran Arabic Bot" },
      "minimumSize": { "width": 300, "height": 400 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 560 },
      "preferredFloatingSize": { "width": 360, "height": 600 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/icon.svg", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/icon.svg", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ]
}
